<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="spirit_skroutzfeed">
        <!-- Runs every minute but only generates a store's feed when it is due or was requested from the admin -->
        <job name="spirit_skroutzfeed_generate" instance="Spirit\SkroutzFeed\Cron\Generate" method="execute">
            <schedule>* * * * *</schedule>
        </job>
    </group>
</config>
