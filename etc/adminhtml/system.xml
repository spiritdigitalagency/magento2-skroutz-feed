<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <!-- Same tab and section as Spirit_Skroutz (analytics): the two modules share one Skroutz page -->
        <tab id="spirit" translate="label" sortOrder="800" class="spirit-tab">
            <label>Spirit</label>
        </tab>
        <section id="spirit_skroutz" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Skroutz</label>
            <tab>spirit</tab>
            <resource>Spirit_Skroutz::config</resource>
            <group id="feed" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>XML Feed</label>
                <field id="status" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[One feed per website.]]></comment>
                </field>
                <field id="store" translate="label comment" type="select" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Store View</label>
                    <source_model>Spirit\SkroutzFeed\Model\Config\Source\StoreView</source_model>
                    <comment><![CDATA[The store view that gives the feed its language, names and links. With several languages, pick the Greek one.]]></comment>
                    <depends>
                        <field id="status">1</field>
                    </depends>
                </field>
                <field id="filename" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>File Name</label>
                    <comment><![CDATA[Without extension, different for each website. Empty: the website code. The feed is written to pub/media/skroutz/&lt;name&gt;.xml and .xml.gz.]]></comment>
                    <depends>
                        <field id="status">1</field>
                    </depends>
                </field>
                <field id="schedule" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Schedule</label>
                    <backend_model>Spirit\SkroutzFeed\Model\Config\Backend\Schedule</backend_model>
                    <comment><![CDATA[When Magento cron generates the feeds: a cron expression in the time zone of the store. The default, 50 6-23 * * *, generates them at 06:50, 07:50 ... 23:50, ready before every full hour from 07:00 to midnight. Every hour: 0 * * * *. Every 30 minutes: */30 * * * *. Empty: only with "Generate now". Skroutz requires at least one update a day.]]></comment>
                </field>
                <field id="max_drop" translate="label comment" type="text" sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Safety Check (%)</label>
                    <validate>validate-digits validate-digits-range digits-range-0-100</validate>
                    <comment><![CDATA[A new feed with this percentage fewer products than the one online is not published: the previous feed stays, so a fault never takes your products off Skroutz. 0 turns the check off. An incomplete or broken feed is never published, whatever this setting.]]></comment>
                </field>
                <field id="status_info" translate="label" type="button" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Feed</label>
                    <frontend_model>Spirit\SkroutzFeed\Block\Adminhtml\System\Config\Status</frontend_model>
                </field>
            </group>
            <group id="feed_mapping" translate="label comment" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>XML Feed: Field Mapping</label>
                <comment><![CDATA[Pick the product attribute that holds each Skroutz field. Link, image, gallery, price, quantity, availability and weight are read by the module.]]></comment>
                <field id="id" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Unique ID</label>
                    <source_model>SpiritSkroutzFeedIdSource</source_model>
                    <frontend_model>Spirit\SkroutzFeed\Block\Adminhtml\System\Config\UniqueId</frontend_model>
                    <validate>required-entry</validate>
                    <comment><![CDATA[Must never change for a product and never be reused: changing it makes Skroutz see every product as new. Skroutz Analytics must send the same attribute with orders.]]></comment>
                </field>
                <field id="variation_id" translate="label comment" type="select" sortOrder="11" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Variation ID</label>
                    <source_model>SpiritSkroutzFeedVariationIdSource</source_model>
                    <validate>required-entry</validate>
                    <comment><![CDATA[The Unique ID of each size in &lt;variations&gt;. Keep the attribute an existing feed already uses for sizes (often the SKU of the child), or Skroutz sees every size as new and orders imported by it stop matching.]]></comment>
                </field>
                <field id="name" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Name</label>
                    <source_model>SpiritSkroutzFeedAttributeSource</source_model>
                    <comment><![CDATA[Include brand, model and variant. Skroutz Analytics requires the same name it receives with each order.]]></comment>
                </field>
                <field id="description" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Description</label>
                    <source_model>SpiritSkroutzFeedAttributeSource</source_model>
                    <comment><![CDATA[HTML is removed. Up to 10,000 characters.]]></comment>
                </field>
                <field id="category" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Category</label>
                    <source_model>SpiritSkroutzFeedAutoSource</source_model>
                    <comment><![CDATA["Automatic" writes the full path of the deepest active category of the product, e.g. "Shoes > Sneakers".]]></comment>
                </field>
                <field id="category_fixed" translate="label" type="text" sortOrder="41" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Category Value</label>
                    <depends>
                        <field id="category">__fixed</field>
                    </depends>
                </field>
                <field id="manufacturer" translate="label comment" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Manufacturer</label>
                    <source_model>SpiritSkroutzFeedFixedAttributeSource</source_model>
                    <comment><![CDATA[Required by Skroutz.]]></comment>
                </field>
                <field id="manufacturer_fixed" translate="label" type="text" sortOrder="51" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Manufacturer Value</label>
                    <depends>
                        <field id="manufacturer">__fixed</field>
                    </depends>
                </field>
                <field id="mpn" translate="label comment" type="select" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>MPN / ISBN</label>
                    <source_model>SpiritSkroutzFeedAttributeSource</source_model>
                    <comment><![CDATA[Required by Skroutz. The manufacturer code, the ISBN for books.]]></comment>
                </field>
                <field id="ean" translate="label comment" type="select" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>EAN / Barcode</label>
                    <source_model>SpiritSkroutzFeedAttributeSource</source_model>
                    <comment><![CDATA[Required by Skroutz. 8 to 14 digits; other values are left out and listed in the report.]]></comment>
                </field>
                <field id="color" translate="label comment" type="multiselect" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Color Attributes</label>
                    <source_model>SpiritSkroutzFeedAttributeListSource</source_model>
                    <can_be_empty>1</can_be_empty>
                    <comment><![CDATA[Required for fashion. Every attribute that holds a color; a product uses the first one it has a value for.]]></comment>
                </field>
                <field id="size" translate="label comment" type="multiselect" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Size Attributes</label>
                    <source_model>SpiritSkroutzFeedAttributeListSource</source_model>
                    <can_be_empty>1</can_be_empty>
                    <comment><![CDATA[Required for products with sizes. Usually one per product type (shoes, clothing...). A configurable product varying by a size attribute is listed once per color (and per other option), with Unique ID "parent ID-option ID" and its sizes nested as variations. Without a size attribute, each child is listed as its own product.]]></comment>
                </field>
                <field id="vat" translate="label comment" type="select" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>VAT Rate</label>
                    <source_model>SpiritSkroutzFeedAutoSource</source_model>
                    <comment><![CDATA["Automatic" uses the tax rate of the product tax class for the default tax destination of the store.]]></comment>
                </field>
                <field id="vat_fixed" translate="label" type="text" sortOrder="101" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>VAT Rate Value</label>
                    <depends>
                        <field id="vat">__fixed</field>
                    </depends>
                </field>
                <field id="shipping" translate="label comment" type="select" sortOrder="110" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Shipping Cost</label>
                    <source_model>SpiritSkroutzFeedShippingSource</source_model>
                    <comment><![CDATA[Only if the shipping cost is the same for every location: Skroutz drops it from all products if it is wrong for one.]]></comment>
                </field>
                <field id="shipping_fixed" translate="label" type="text" sortOrder="111" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Shipping Cost Value</label>
                    <depends>
                        <field id="shipping">__fixed</field>
                    </depends>
                </field>
                <field id="shipping_cost" translate="label comment" type="text" sortOrder="112" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Cost</label>
                    <validate>validate-number</validate>
                    <comment><![CDATA[Up to the weight below.]]></comment>
                    <depends>
                        <field id="shipping">__auto</field>
                    </depends>
                </field>
                <field id="shipping_weight" translate="label" type="text" sortOrder="113" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Weight Included (kg)</label>
                    <validate>validate-number</validate>
                    <depends>
                        <field id="shipping">__auto</field>
                    </depends>
                </field>
                <field id="shipping_extra_kg" translate="label" type="text" sortOrder="114" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Cost per Extra Kilo</label>
                    <validate>validate-number</validate>
                    <depends>
                        <field id="shipping">__auto</field>
                    </depends>
                </field>
                <field id="shipping_free_over" translate="label comment" type="text" sortOrder="115" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Free Shipping From</label>
                    <validate>validate-number</validate>
                    <comment><![CDATA[Product price with VAT. Empty: never free.]]></comment>
                    <depends>
                        <field id="shipping">__auto</field>
                    </depends>
                </field>
                <field id="wholesale_price" translate="label comment" type="select" sortOrder="120" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Wholesale Price</label>
                    <source_model>SpiritSkroutzFeedAttributeSource</source_model>
                    <comment><![CDATA[Purchase price without VAT. The feed is public: map it only if Skroutz asked for it.]]></comment>
                </field>
                <field id="season" translate="label comment" type="select" sortOrder="130" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Season</label>
                    <source_model>SpiritSkroutzFeedFixedAttributeSource</source_model>
                    <comment><![CDATA[e.g. SS26.]]></comment>
                </field>
                <field id="season_fixed" translate="label" type="text" sortOrder="131" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Season Value</label>
                    <depends>
                        <field id="season">__fixed</field>
                    </depends>
                </field>
                <field id="size_fit" translate="label comment" type="select" sortOrder="140" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Size Fit</label>
                    <source_model>SpiritSkroutzFeedFixedAttributeSource</source_model>
                    <comment><![CDATA[e.g. regular, slim.]]></comment>
                </field>
                <field id="size_fit_fixed" translate="label" type="text" sortOrder="141" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Size Fit Value</label>
                    <depends>
                        <field id="size_fit">__fixed</field>
                    </depends>
                </field>
                <field id="outlet" translate="label comment" type="select" sortOrder="150" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Outlet</label>
                    <source_model>SpiritSkroutzFeedFixedAttributeSource</source_model>
                    <comment><![CDATA[A Yes/No attribute, or a fixed Y or N.]]></comment>
                </field>
                <field id="outlet_fixed" translate="label" type="text" sortOrder="151" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Outlet Value</label>
                    <depends>
                        <field id="outlet">__fixed</field>
                    </depends>
                </field>
                <field id="author" translate="label comment" type="select" sortOrder="160" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Author</label>
                    <source_model>SpiritSkroutzFeedFixedAttributeSource</source_model>
                    <comment><![CDATA[For books.]]></comment>
                </field>
                <field id="author_fixed" translate="label" type="text" sortOrder="161" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Author Value</label>
                    <depends>
                        <field id="author">__fixed</field>
                    </depends>
                </field>
                <field id="expiration_date" translate="label comment" type="select" sortOrder="170" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Expiration Date</label>
                    <source_model>SpiritSkroutzFeedAttributeSource</source_model>
                    <comment><![CDATA[For perishables, cosmetics and supplements.]]></comment>
                </field>
                <field id="country_of_origin" translate="label" type="select" sortOrder="180" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Country of Origin</label>
                    <source_model>SpiritSkroutzFeedFixedAttributeSource</source_model>
                </field>
                <field id="country_of_origin_fixed" translate="label" type="text" sortOrder="181" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Country of Origin Value</label>
                    <depends>
                        <field id="country_of_origin">__fixed</field>
                    </depends>
                </field>
                <field id="specifications_mode" translate="label comment" type="select" sortOrder="190" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Specifications</label>
                    <source_model>SpiritSkroutzFeedSpecificationsSource</source_model>
                    <comment><![CDATA[Product characteristics, written as &lt;spec name="Label"&gt;value&lt;/spec&gt; with the labels of the store view. "Attributes shown on the product page" follows the "Visible on Catalog Pages on Storefront" setting of each attribute (Stores &gt; Attributes &gt; Product). Attributes mapped to a field above are left out: Skroutz ignores them.]]></comment>
                </field>
                <field id="specifications" translate="label comment" type="multiselect" sortOrder="191" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Specification Attributes</label>
                    <source_model>SpiritSkroutzFeedAttributeListSource</source_model>
                    <can_be_empty>1</can_be_empty>
                    <depends>
                        <field id="specifications_mode" separator=",">selected,storefront_except</field>
                    </depends>
                    <comment><![CDATA[The attributes to export, or to leave out.]]></comment>
                </field>
            </group>
            <group id="feed_products" translate="label" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>XML Feed: Products and Variations</label>
                <field id="exclude_no_image" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Exclude Products Without Image</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[Skroutz requires an image and marks products without one "to be fixed". No: they are listed, and the report names them.]]></comment>
                </field>
                <field id="category_filter" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Category Filter</label>
                    <source_model>SpiritSkroutzFeedCategoryFilterSource</source_model>
                </field>
                <field id="categories" translate="label comment" type="multiselect" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Categories</label>
                    <source_model>Spirit\SkroutzFeed\Model\Config\Source\Categories</source_model>
                    <can_be_empty>1</can_be_empty>
                    <comment><![CDATA[Subcategories are included. A single product is excluded with its "Exclude from Skroutz" attribute. Disabled and not visible products, bundles and grouped products are never listed, and children of configurable products only as variations of their parent.]]></comment>
                </field>
                <field id="single_size" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Do Not Nest a Single Size</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[For "one size" fashion items set up as configurable products: when all children have the same size, each color is written as a plain product, without &lt;variations&gt;.]]></comment>
                </field>
                <field id="variant_name" translate="label comment" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Variant Name</label>
                    <source_model>SpiritSkroutzFeedVariantNameSource</source_model>
                    <comment><![CDATA[The name of a color, or of a child of a configurable listed on its own. Skroutz asks for the color in the name; other options keep the names of variants apart.]]></comment>
                </field>
            </group>
            <group id="feed_stock" translate="label comment" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>XML Feed: Availability and Stock</label>
                <comment><![CDATA[The availability text of each stock state. Products can override it with their "Skroutz Availability" attributes, and children of configurable products inherit those of their parent.]]></comment>
                <field id="in_stock" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>In Stock</label>
                    <source_model>Spirit\SkroutzFeed\Model\Config\Source\Availability</source_model>
                    <comment><![CDATA["Άμεσα διαθέσιμο" is for products you ship the same day: it qualifies them for Skroutz Express delivery.]]></comment>
                </field>
                <field id="backorder" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>On Backorder</label>
                    <source_model>SpiritSkroutzFeedAvailabilityHideSource</source_model>
                    <comment><![CDATA[Products with backorders enabled and no quantity.]]></comment>
                </field>
                <field id="out_of_stock" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Out of Stock</label>
                    <source_model>SpiritSkroutzFeedAvailabilityHideSource</source_model>
                    <comment><![CDATA[Listed with quantity 0 unless hidden.]]></comment>
                </field>
                <field id="unmanaged_qty" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Quantity When Stock Is Not Managed</label>
                    <validate>validate-digits</validate>
                    <comment><![CDATA[Skroutz requires a quantity for every product.]]></comment>
                </field>
            </group>
        </section>
    </system>
</config>
